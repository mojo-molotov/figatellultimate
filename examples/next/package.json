{
  "name": "figatellultimate-example-next",
  "private": true,
  "description": "Pages, a blog and landing pages, built with figatellultimate and Next.js 16 by configuration only.",
  "type": "module",
  "imports": {
    "#figatellultimate/*": "./.figatellultimate/*/index.js"
  },
  "scripts": {
    "generate": "figatellultimate build",
    "dev": "turbo run build --filter=figatellultimate-example-next^... && figatellultimate build && next dev",
    "example:build": "turbo run build --filter=figatellultimate-example-next^... && figatellultimate build && next build && node scripts/search.ts",
    "example:verify": "node scripts/verify.ts",
    "example:browse": "node scripts/browse.ts",
    "example:load": "node scripts/load-test.ts"
  },
  "dependencies": {
    "@content-collections/mdx": "0.2.2",
    "@figatellultimate/effects": "workspace:*",
    "@figatellultimate/facets": "workspace:*",
    "@figatellultimate/facets-react": "workspace:*",
    "@figatellultimate/next16": "workspace:*",
    "@figatellultimate/search": "workspace:*",
    "@figatellultimate/search-react": "workspace:*",
    "@figatellultimate/site": "workspace:*",
    "@figatellultimate/themes": "workspace:*",
    "@figatellultimate/toc": "workspace:*",
    "@figatellultimate/ui": "workspace:*",
    "@figatellultimate/use-intl": "workspace:*",
    "@heroicons/react": "2.2.0",
    "@shikijs/rehype": "4.6.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.1.0",
    "icu-minify": "4.15.0",
    "next": "16.4.6",
    "next-intl": "4.15.3",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-autolink-headings": "7.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@content-collections/core": "0.15.3",
    "@figatellultimate/cli": "workspace:*",
    "@figatellultimate/content-collections": "workspace:*",
    "@figatellultimate/core": "workspace:*",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.1",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "valibot": "1.5.0"
  }
}
