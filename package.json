{
  "name": "figatellultimate-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0 && eslint --config examples/next/eslint.config.ts --max-warnings 0 examples/next",
    "depcruise": "depcruise packages --config .dependency-cruiser.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.check.json && turbo run typecheck",
    "test": "turbo run test test:tooling",
    "test:lab": "vitest run --config vitest.lab.config.ts",
    "test:cli": "turbo run test:cli",
    "test:coverage": "vitest run --coverage",
    "allure": "allure generate allure-results && allure open allure-report",
    "build": "turbo run build",
    "lint:packages": "turbo run lint:package",
    "knip": "knip",
    "check": "pnpm format:check && pnpm lint && pnpm depcruise && pnpm knip && pnpm typecheck && pnpm test && pnpm build && pnpm test:cli && pnpm lint:packages",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:tooling": "vitest run --project tooling"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint-react/eslint-plugin": "5.30.6",
    "@eslint/js": "10.0.1",
    "@japa/file-system": "3.0.0",
    "@stylistic/eslint-plugin": "6.0.1",
    "@testing-library/dom": "10.4.2",
    "@types/node": "24.19.2",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "allure": "3.33.0",
    "allure-vitest": "3.14.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.15.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "husky": "9.1.7",
    "knip": "6.47.0",
    "playwright": "1.64.1",
    "prettier": "3.10.1",
    "publint": "0.3.25",
    "tsdown": "0.23.7",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
