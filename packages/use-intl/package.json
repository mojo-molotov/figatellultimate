{
  "name": "@figatellultimate/use-intl",
  "version": "0.0.0",
  "description": "use-intl adapter of figatellultimate: a translator typed by the generated messages (keys, ICU arguments, scopes).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@figatellultimate/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "@figatellultimate/source": "./src/react.ts",
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./precompile": {
      "@figatellultimate/source": "./src/precompile.ts",
      "types": "./dist/precompile.d.ts",
      "default": "./dist/precompile.js"
    },
    "./format": {
      "@figatellultimate/source": "./src/format.ts",
      "types": "./dist/format.d.ts",
      "default": "./dist/format.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./react": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "./precompile": {
        "types": "./dist/precompile.d.ts",
        "default": "./dist/precompile.js"
      },
      "./format": {
        "types": "./dist/format.d.ts",
        "default": "./dist/format.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --project use-intl",
    "lint:package": "publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {},
  "figatellultimate": {
    "role": "adapter"
  },
  "peerDependencies": {
    "use-intl": "^4.14.0",
    "react": "^19.0.0",
    "icu-minify": "^4.14.9"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "icu-minify": "4.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "use-intl": "4.14.9"
  }
}
