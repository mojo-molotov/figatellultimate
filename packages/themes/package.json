{
  "name": "@figatellultimate/themes",
  "version": "0.0.0",
  "description": "Themes for figatellultimate apps: a shared base and one stylesheet per theme (maquis, calanque), over @figatellultimate/ui and @figatellultimate/effects, on their tokens and slots.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./base.css": {
      "@figatellultimate/source": "./src/base.css",
      "default": "./dist/base.css"
    },
    "./maquis.css": {
      "@figatellultimate/source": "./src/maquis.css",
      "default": "./dist/maquis.css"
    },
    "./calanque.css": {
      "@figatellultimate/source": "./src/calanque.css",
      "default": "./dist/calanque.css"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      "./base.css": {
        "default": "./dist/base.css"
      },
      "./maquis.css": {
        "default": "./dist/maquis.css"
      },
      "./calanque.css": {
        "default": "./dist/calanque.css"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"const fs=require('node:fs');fs.mkdirSync('dist',{recursive:true});for(const f of ['base','maquis','calanque'])fs.copyFileSync('src/'+f+'.css','dist/'+f+'.css')\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --project themes",
    "lint:package": "publint --strict"
  },
  "figatellultimate": {
    "role": "adapter"
  },
  "devDependencies": {
    "@types/node": "24.19.2"
  }
}
