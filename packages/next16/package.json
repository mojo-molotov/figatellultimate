{
  "name": "@figatellultimate/next16",
  "version": "0.0.0",
  "description": "Next.js 16 adapter of figatellultimate: site metadata, sitemap, redirects, the facets URL adapter, the listings' indexes and the build's folders. The major version of Next is in the name.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@figatellultimate/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./facets": {
      "@figatellultimate/source": "./src/facets.ts",
      "types": "./dist/facets.d.ts",
      "default": "./dist/facets.js"
    },
    "./config": {
      "@figatellultimate/source": "./src/config.ts",
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./listing-index": {
      "@figatellultimate/source": "./src/listing-index.ts",
      "types": "./dist/listing-index.d.ts",
      "default": "./dist/listing-index.js"
    },
    "./build": {
      "@figatellultimate/source": "./src/build.ts",
      "types": "./dist/build.d.ts",
      "default": "./dist/build.js"
    },
    "./images": {
      "@figatellultimate/source": "./src/images.ts",
      "types": "./dist/images.d.ts",
      "default": "./dist/images.js"
    },
    "./themes": {
      "@figatellultimate/source": "./src/themes.ts",
      "types": "./dist/themes.d.ts",
      "default": "./dist/themes.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./facets": {
        "types": "./dist/facets.d.ts",
        "default": "./dist/facets.js"
      },
      "./config": {
        "types": "./dist/config.d.ts",
        "default": "./dist/config.js"
      },
      "./listing-index": {
        "types": "./dist/listing-index.d.ts",
        "default": "./dist/listing-index.js"
      },
      "./build": {
        "types": "./dist/build.d.ts",
        "default": "./dist/build.js"
      },
      "./images": {
        "types": "./dist/images.d.ts",
        "default": "./dist/images.js"
      },
      "./themes": {
        "types": "./dist/themes.d.ts",
        "default": "./dist/themes.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --project next16",
    "lint:package": "publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@figatellultimate/facets": "workspace:*",
    "@figatellultimate/site": "workspace:*"
  },
  "figatellultimate": {
    "role": "adapter"
  },
  "devDependencies": {
    "@japa/file-system": "3.0.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "21.0.4",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "peerDependencies": {
    "next": "^16.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
