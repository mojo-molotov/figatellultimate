"// Generated by figatellultimate. Do not edit: run \`figatellultimate build\` instead.
/** The content's required messages with every text a hole, for an app schema to spread. */
export const skeleton = Object.freeze({
    "content": Object.freeze({
        "blog": Object.freeze({
            "patch-notes": Object.freeze({
                "$": Object.freeze({
                    "title": ""
                }),
                "bot": Object.freeze({
                    "$": Object.freeze({
                        "title": ""
                    })
                })
            })
        })
    }),
    "taxonomies": Object.freeze({
        "tags": Object.freeze({
            "bot": Object.freeze({
                "label": ""
            })
        })
    })
});
const modules = {
    "fr": () => import("../../messages/fr.ts"),
    "en": () => import("../../messages/en.ts")
};
/** A locale's messages, as validated at build time, loaded lazily. */
export async function loadMessages(locale) {
    return (await modules[locale]()).default;
}
"
`;

