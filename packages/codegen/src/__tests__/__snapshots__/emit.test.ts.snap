"// Generated by figatellu. Do not edit: run \`figatellu build\` instead.
import type { Locale } from '../locales/index.js';
/** Frontmatter data of a BlogPost (from the content source's schema when it provides a type). */
export type BlogPostData = Readonly<Record<string, unknown>>;
/** Every existing BlogPost: category → subcategory → slug → locales in which it exists. */
export interface BlogPostTree {
  readonly "patch-notes": {
    readonly "bot": {
      readonly "post-02": "fr";
    };
    readonly "dashboard": {
      readonly "post-01": "fr" | "en";
    };
  };
}
/** A query checked at runtime by \`isBlogPostQuery\` (from untrusted strings). */
export type ValidatedBlogPostQuery = {
  readonly locale: string;
  readonly category: string;
  readonly subcategory: string;
  readonly slug: string;
} & {
  readonly '~validated': "blog";
};
/** Light index item: everything but the data and the body, which are loaded lazily. */
export interface BlogPostIndexItem {
  readonly key: string;
  readonly locale: Locale;
  readonly route: string;
  readonly url: string;
  readonly alternates: Readonly<Partial<Record<Locale, string>>>;
  readonly segments: Readonly<Record<string, string>>;
  readonly slug: string;
  readonly terms: {
    readonly "tags": readonly ("cello" | "drums")[];
  };
  readonly draft: boolean;
  readonly reserved: boolean;
  readonly query: Readonly<Record<string, string>>;
  readonly load: () => Promise<{
    readonly data: BlogPostData;
    readonly body: string;
  }>;
}
export type BlogPost = Omit<BlogPostIndexItem, 'load'> & {
  readonly data: BlogPostData;
  readonly body: string;
};
"
`;

