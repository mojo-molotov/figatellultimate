"// Generated by figatellu. Do not edit: run \`figatellu build\` instead.
/** Every BlogPost of the build, light (no data, no body). */
export const blogIndex = [
    {
        key: "patch-notes/bot/post-02",
        locale: "fr",
        route: "/blog/patch-notes/bot/post-02",
        url: "/blog/patch-notes/bot/post-02",
        alternates: { "fr": "/blog/patch-notes/bot/post-02" },
        segments: { "category": "patch-notes", "subcategory": "bot" },
        slug: "post-02",
        terms: { "tags": ["cello"] },
        draft: false,
        reserved: false,
        query: { "locale": "fr", "category": "patch-notes", "subcategory": "bot", "slug": "post-02" },
        load: () => import("./entries/fr/patch-notes/bot/post-02.js")
    },
    {
        key: "patch-notes/dashboard/post-01",
        locale: "en",
        route: "/blog/patch-notes/dashboard/post-01",
        url: "/en/blog/patch-notes/dashboard/post-01",
        alternates: { "fr": "/blog/patch-notes/dashboard/post-01", "en": "/en/blog/patch-notes/dashboard/post-01" },
        segments: { "category": "patch-notes", "subcategory": "dashboard" },
        slug: "post-01",
        terms: { "tags": ["cello"] },
        draft: false,
        reserved: false,
        query: { "locale": "en", "category": "patch-notes", "subcategory": "dashboard", "slug": "post-01" },
        load: () => import("./entries/en/patch-notes/dashboard/post-01.js")
    },
    {
        key: "patch-notes/dashboard/post-01",
        locale: "fr",
        route: "/blog/patch-notes/dashboard/post-01",
        url: "/blog/patch-notes/dashboard/post-01",
        alternates: { "fr": "/blog/patch-notes/dashboard/post-01", "en": "/en/blog/patch-notes/dashboard/post-01" },
        segments: { "category": "patch-notes", "subcategory": "dashboard" },
        slug: "post-01",
        terms: { "tags": ["cello"] },
        draft: false,
        reserved: false,
        query: { "locale": "fr", "category": "patch-notes", "subcategory": "dashboard", "slug": "post-01" },
        load: () => import("./entries/fr/patch-notes/dashboard/post-01.js")
    },
];
const PARAMETERS = ["locale", "category", "subcategory", "slug"];
/** The single, untyped lookup behind getX and findX: no narrowing paid twice. */
const lookupKey = (query) => PARAMETERS.map((parameter) => String(query[parameter])).join('\\u0000');
const byQuery = new Map(blogIndex.map((item) => [lookupKey(item.query), item]));
/** The URLs the build produced, by the single URL rule: looked up, never parsed. */
const byUrl = new Map(blogIndex.map((item) => [item.url, item]));
/** Loads an entry from its light index item. */
const entryOf = async (item) => {
    const { load, ...rest } = item;
    const { data, body } = await load();
    return { ...rest, data, body };
};
/** Whether a value designates an existing BlogPost: the guard at the URL boundary. */
export function isBlogPostQuery(value) {
    if (typeof value !== 'object' || value === null)
        return false;
    const record = value;
    return PARAMETERS.every((parameter) => typeof record[parameter] === 'string') && byQuery.has(lookupKey(record));
}
export async function getBlogPost(query) {
    const item = byQuery.get(lookupKey(query));
    if (item === undefined)
        throw new Error(\`No BlogPost for \${JSON.stringify(query)}: the generated code is out of date (run figatellu build).\`);
    return entryOf(item);
}
/** A BlogPost from untrusted strings (URL params): \`undefined\` when it does not exist. */
export async function findBlogPost(query) {
    return isBlogPostQuery(query) ? getBlogPost(query) : undefined;
}
/** The BlogPost at a URL, exactly as the build produced it (\`/en/docs/setup\`): \`undefined\` otherwise. */
export async function findBlogPostByUrl(url) {
    const item = byUrl.get(url);
    return item === undefined ? undefined : entryOf(item);
}
/** Light index items of a locale, optionally filtered by leading segments. */
export function listBlog(filter) {
    const record = filter;
    return blogIndex.filter((item) => PARAMETERS.every((parameter) => record[parameter] === undefined || item.query[parameter] === record[parameter]));
}
/** Facet indexes: for each taxonomy reference, term → URLs of the entries carrying it. */
export const blogFacets = { "tags": { "cello": ["/blog/patch-notes/bot/post-02", "/blog/patch-notes/dashboard/post-01", "/en/blog/patch-notes/dashboard/post-01"] } };
"
`;

