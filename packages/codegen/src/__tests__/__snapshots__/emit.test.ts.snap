export declare function isBlogPostQuery(value: unknown): value is ValidatedBlogPostQuery;
/** An existing BlogPost, typed by the content: each parameter is narrowed by the previous ones. */
export declare function getBlogPost<T0 extends keyof BlogPostTree, T1 extends keyof BlogPostTree[T0], T2 extends keyof BlogPostTree[T0][T1], L extends BlogPostTree[T0][T1][T2] & Locale>(query: {
  readonly locale: L;
  readonly category: T0;
  readonly subcategory: T1;
  readonly slug: T2;
}): Promise<BlogPost>;
/** A BlogPost whose query was checked by \`isBlogPostQuery\`. */
export declare function getBlogPost(query: ValidatedBlogPostQuery): Promise<BlogPost>;
/** A BlogPost from untrusted strings (URL params): \`undefined\` when it does not exist. */
export declare function findBlogPost(query: {
  readonly [K in (typeof PARAMETERS)[number]]: string;
}): Promise<BlogPost | undefined>;
/** The BlogPost at a URL, exactly as the build produced it (\`/en/docs/setup\`): \`undefined\` otherwise. */
export declare function findBlogPostByUrl(url: string): Promise<BlogPost | undefined>;
/** Light index items of a locale, optionally filtered by leading segments. */
export declare function listBlog(filter: {
  readonly locale: Locale;
  readonly category?: keyof BlogPostTree;
  readonly subcategory?: {
    [K0 in keyof BlogPostTree]: keyof BlogPostTree[K0];
  }[keyof BlogPostTree];
}): readonly BlogPostIndexItem[];
/** Facet indexes: for each taxonomy reference, term → URLs of the entries carrying it. */
export declare const blogFacets: {
  readonly "tags": Readonly<Record<string, readonly string[]>>;
