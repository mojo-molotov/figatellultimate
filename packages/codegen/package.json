{
  "name": "@figatellu/codegen",
  "version": "0.0.0",
  "description": "Code generator of figatellu: turns a validated assembly into typed modules (ts-morph, in memory).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@figatellu/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --project codegen",
    "lint:package": "publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@figatellu/core": "workspace:*",
    "@figatellu/messages": "workspace:*",
    "ts-morph": "28.0.0"
  },
  "figatellu": {
    "role": "tooling"
  },
  "devDependencies": {
    "valibot": "1.5.0"
  }
}
