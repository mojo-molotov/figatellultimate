{
  "name": "@figatellu/fs-node",
  "version": "0.0.0",
  "description": "Node.js file system adapter of figatellu: lists content paths for the PathLister port.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@figatellu/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --project fs-node",
    "lint:package": "publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@figatellu/core": "workspace:*"
  },
  "figatellu": {
    "role": "adapter"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  }
}
