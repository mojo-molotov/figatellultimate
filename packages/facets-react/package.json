{
  "name": "@figatellu/facets-react",
  "version": "0.0.0",
  "description": "React binding of figatellu faceted collections: a hook that only handles keys, and the History API URL adapter.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@figatellu/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --project facets-react",
    "lint:package": "publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@figatellu/facets": "workspace:*",
    "cmdk": "1.1.1",
    "radix-ui": "1.8.1"
  },
  "figatellu": {
    "role": "adapter"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "happy-dom": "21.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
