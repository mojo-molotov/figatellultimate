{
  "name": "@figatellu/toc",
  "version": "0.0.0",
  "description": "Table of contents model of figatellu: the tree of headings and the active heading, pure.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@figatellu/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --project toc",
    "lint:package": "publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {},
  "figatellu": {
    "role": "runtime"
  },
  "devDependencies": {}
}
